APP_ENV=dev
APP_MODE=real
APP_NAME=RAG Agent Platform

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

DOCUMENT_REPOSITORY_PROVIDER=mysql
METADATA_PATH=data/metadata/documents.json
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=rag_child_chunks
GRAPH_PERSIST_DIRECTORY=data/graph
UPLOAD_DIRECTORY=data/uploads
RETRIEVAL_TOP_K=5
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
RERANK_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
AGENT_MAX_RETRIES=2
AGENT_MAX_REGENERATIONS=1
HASH_EMBEDDING_DIMENSIONS=32

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_agent
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=5
